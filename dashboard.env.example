# Dashboard (Next.js) settings. On the server this file is `dashboard.env` next to
# docker-compose.yml, mode 600, never committed. scripts/make-server-env.sh creates it.
# DASHBOARD_API_ORIGIN is set in docker-compose.yml (http://api:8000), not here.

# [NEW] Same value as DASHBOARD_API_TOKEN in .env.
DASHBOARD_API_TOKEN=

# [NEW] 40+ random characters. Signs the 12-hour staff login cookie. Changing it logs everyone out.
DASHBOARD_SESSION_SECRET=

# Staff logins, one JSON list on one line, inside SINGLE quotes (so Docker keeps $ and # as typed).
# Rules: id is 3-32 lower-case letters/digits/.-_, password at least 12 characters and without a
# single quote ('), role "super_admin" or "employee", exactly ONE super_admin. "email" is optional
# (staff can then sign in with it too).
# To keep today's staff logins, copy DASHBOARD_USERS_JSON from the Vercel project
# (rpt-frontend -> Settings -> Environment Variables) and paste it between the single quotes.
DASHBOARD_USERS_JSON='[{"id":"admin","name":"Clinic Admin","password":"CHANGE-ME-12+chars","role":"super_admin"}]'

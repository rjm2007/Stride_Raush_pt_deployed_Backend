# Backend settings for the production server (api, worker, sheet-worker read this file).
# On the server this file is `.env` next to docker-compose.yml, mode 600, never committed.
# scripts/make-server-env.sh builds it from this template (see Deployment-AWS-EC2.md, step 6).
#
# Marks:  [COPY]  same value as the old server .env (Vapi/Twilio are shared with the old setup)
#         [NEW]   generate a fresh random value
#         [FILL]  you type it in
#         no mark = keep exactly as written

# --- Environment --------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# Testing switch. true = every NEW Sheet lead is a test lead: each cadence day lasts one minute
# (TESTING_DAY_MINUTES) and calling hours and daily limits are ignored, so the whole 14-day flow
# runs in about 15 minutes. false = real production. Leads keep the mode they were created in:
# delete the test leads before real patients come in. The dashboard shows a banner while it is on.
TESTING_MODE=false
TESTING_DAY_MINUTES=1

# Master switch for anything that reaches a patient (calls and texts). Start with false,
# check everything, then set true and restart the worker (deployment doc, step 11).
OUTBOUND_ENABLED=false

# --- Database (client's production Supabase) -------------------------------------
# [FILL] Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
# (port 5432), with the database password filled in, and ?sslmode=require at the end.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Public URLs ----------------------------------------------------------------
# The domain Caddy serves (Caddyfile). Twilio signatures and Vapi callbacks use it.
PUBLIC_BASE_URL=https://stride.aibolt.ai
# The dashboard is on the same domain; Sheet "Transcript Link" cells point here.
DASHBOARD_PUBLIC_URL=https://stride.aibolt.ai
API_BASE_URL=http://api:8000

# [NEW] Shared secret between the dashboard and this backend (40+ random characters).
# Must be the same value as DASHBOARD_API_TOKEN in dashboard.env.
DASHBOARD_API_TOKEN=

# --- Google Sheet (the only way leads come in) -------------------------------------
PRACTICE_SLUG=rausch-pt
SHEET_SYNC_ENABLED=true
# [COPY or FILL] The Sheet's id: the long part of its URL between /d/ and /edit. Copied from the old
# server .env when it has one; otherwise type it.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
# Row 1 is free for a title; the column names are on row 2.
GOOGLE_SHEET_HEADER_ROW=2
# Inside the container. The key file itself lives on the server at
# /home/ubuntu/rpt-secrets/google-sheet-sa.json (docker-compose.yml mounts it here).
GOOGLE_SHEET_CREDENTIALS_FILE=/run/secrets/google-sheet-sa.json
SHEET_SYNC_POLL_SECONDS=30
# Nightly move of finished rows to an "Archive" tab. Off until the clinic agrees.
SHEET_ARCHIVE_ENABLED=false

# --- Vapi (voice calls) -------------------------------------------------------------
PROVIDER_MODE=real
# [COPY] from the old server .env
VAPI_API_KEY=
# The outreach agent (sends the booking link, transfers, books callbacks). Not the booking agent.
VAPI_ASSISTANT_ID=540ddb07-711e-4060-8753-f82d848b9a25
# [COPY] from the old server .env (the clinic's calling number in Vapi)
VAPI_PHONE_NUMBER_ID=
# [COPY] from the old server .env. Must stay the same: the live Vapi tool sends this value in
# its X-Vapi-Secret header.
VAPI_WEBHOOK_SECRET=
# [COPY] from the old server .env (may be empty)
VAPI_HMAC_SECRET=

# --- Twilio (texts) ---------------------------------------------------------------------
# [COPY] all three from the old server .env (same clinic number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Other secrets ---------------------------------------------------------------------
# [NEW] Key that turns phone numbers into labels in the test-usage report.
PHONE_FINGERPRINT_SECRET=

# --- Staff AI assistant on the dashboard --------------------------------------------------
# Off: in production it sends real patient details to OpenAI, so it needs a signed approval.
# To turn on later: ASSISTANT_ENABLED=true, ASSISTANT_PHI_APPROVED=true,
# ASSISTANT_PHI_APPROVAL_REFERENCE=<the approval/BAA reference>, and OPENAI_API_KEY.
ASSISTANT_ENABLED=false
ASSISTANT_PHI_APPROVED=false
ASSISTANT_PHI_APPROVAL_REFERENCE=
ASSISTANT_MODEL=gpt-5.6-luna
# [COPY] from the old server .env (only used when the assistant is on)
OPENAI_API_KEY=
LANGSMITH_TRACING=false

# --- Worker and retries (defaults; change only with a reason) ---------------------------------
WORKER_POLL_SECONDS=30
DB_POOL_TIMEOUT_SECONDS=5
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_SECONDS=0.5
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
